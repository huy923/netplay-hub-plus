// Prisma schema for CyberNet
generator client {
	provider      = "prisma-client-js"
	binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
	provider = "sqlite"
	url      = env("DATABASE_URL")
}

model Machine {
	id           String    @id @default(cuid())
	name         String    @unique
	area         String
	ip           String?
	status       String    @default("idle")
	customer     String?
	startedAt    DateTime?
	remaining    String?
	pricePerHour Int
	image        String?
	createdAt    DateTime  @default(now())
	updatedAt    DateTime  @updatedAt
	sessions     MachineSession[]
}

model MachineSession {
	id           String   @id @default(cuid())
	machineId    String
	machineName  String
	customerName String
	startedAt    DateTime
	endedAt      DateTime?
	hoursUsed    Float    @default(0)
	amount       Int      @default(0)
	createdAt    DateTime @default(now())
	machine      Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
}

model MenuItem {
	id        String      @id @default(cuid())
	name      String      @unique
	category  String
	price     Int
	cost      Int         @default(0)
	image     String?
	stock     Int         @default(0)
	lowStockThreshold Int @default(5)
	comboItems ComboItem[]
	purchaseOrders PurchaseOrder[]
	createdAt DateTime    @default(now())
	updatedAt DateTime    @updatedAt
}

model Customer {
	id        String   @id @default(cuid())
	name      String
	phone     String   @unique
	password  String
	visits    Int      @default(0)
	total     Int      @default(0)
	tier      String   @default("Thường")
	points    Int      @default(0)
	loyaltyTransactions LoyaltyTransaction[]
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
}

model Keyboard {
	id           String   @id @default(cuid())
	name         String   @unique
	brand        String
	pricePerHour Int
	status       String   @default("idle")
	image        String?
	machineId    String?
	createdAt    DateTime @default(now())
	updatedAt    DateTime @updatedAt
}

model Invoice {
	id         String   @id @default(cuid())
	machine    String
	customer   String
	amount     Int
	method     String
	status     String   @default("Chờ")
	time       String
	discountId String?
	discount   Discount? @relation(fields: [discountId], references: [id])
	discountAmount Int   @default(0)
	assignedTo String?
	assignedAt DateTime?
	refundedAt DateTime?
	refundReason String?
	createdAt  DateTime @default(now())
	updatedAt  DateTime @updatedAt
	items      InvoiceItem[]
	payments   Payment[]
}

model InvoiceItem {
	id        String   @id @default(cuid())
	invoiceId String
	name      String
	price     Int
	qty       Int      @default(1)
	type      String   @default("menu")
	invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
	createdAt DateTime @default(now())
}

model User {
	id        String   @id @default(cuid())
	username  String   @unique
	password  String
	role      String   @default("cashier")
	active    Boolean  @default(true)
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
}

model Combo {
	id        String      @id @default(cuid())
	name      String      @unique
	price     Int
	seconds   Int
	image     String?
	active    Boolean     @default(true)
	items     ComboItem[]
	createdAt DateTime    @default(now())
	updatedAt DateTime    @updatedAt
}

model ComboItem {
	id         String   @id @default(cuid())
	comboId    String
	menuItemId String
	qty        Int      @default(1)
	combo      Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
	menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}

model CursingRequest {
	id        String   @id @default(cuid())
	machine   String
	customer  String
	price     Int      @default(10000)
	status    String   @default("pending")
	createdAt DateTime @default(now())
}

model Setting {
	id       String @id @default(cuid())
	key      String @unique
	value    String
	category String @default("general")
}

model AuditLog {
	id        String   @id @default(cuid())
	userId    String
	username  String
	action    String
	target    String?
	details   String?
	ip        String?
	createdAt DateTime @default(now())
}

model Discount {
	id         String    @id @default(cuid())
	code       String    @unique
	name       String
	type       String    @default("percent")
	value      Int
	minAmount  Int       @default(0)
	maxUses    Int       @default(0)
	usedCount  Int       @default(0)
	active     Boolean   @default(true)
	expiresAt  DateTime?
	invoices   Invoice[]
	createdAt  DateTime  @default(now())
	updatedAt  DateTime  @updatedAt
}

model PurchaseOrder {
	id        String   @id @default(cuid())
	itemId    String
	itemName  String
	qty       Int
	unitCost  Int
	totalCost Int
	supplier  String   @default("")
	note      String?
	createdAt DateTime @default(now())
	menuItem  MenuItem @relation(fields: [itemId], references: [id])
}

model LoyaltyTransaction {
	id         String   @id @default(cuid())
	customerId String
	points     Int
	type       String   @default("earn")
	reference  String?
	createdAt  DateTime @default(now())
	customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
	id        String   @id @default(cuid())
	ip        String
	username  String
	success   Boolean  @default(false)
	createdAt DateTime @default(now())
}

model Payment {
	id            String   @id @default(cuid())
	invoiceId     String?
	invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
	amount        Int
	method        String   @default("qr")
	status        String   @default("pending")
	reference     String?
	bankCode      String?
	accountNo     String?
	transferNote  String?
	paidAt        DateTime?
	createdAt     DateTime @default(now())
	updatedAt     DateTime @updatedAt
	refunds       Refund[]
}

model Refund {
	id           String   @id @default(cuid())
	paymentId    String
	payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
	invoiceId    String
	amount       Int
	reason       String
	processedBy  String
	status       String   @default("completed")
	createdAt    DateTime @default(now())
}

model Transaction {
	id           String   @id @default(cuid())
	type         String
	amount       Int
	referenceId  String?
	description  String?
	metadata     String?
	createdAt    DateTime @default(now())
}

model Notification {
	id          String   @id @default(cuid())
	type        String
	title       String
	message     String
	targetRole  String?
	read        Boolean  @default(false)
	metadata    String?
	createdAt   DateTime @default(now())
}
